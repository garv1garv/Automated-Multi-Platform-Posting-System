# Server Configuration
HOST=0.0.0.0
PORT=4000
DEBUG=False

# Platform 1: Telegram
# Obtain bot token from @BotFather, and public channel e.g. @yourpublicchannel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Platform 2: Discord
# Create a Webhook URL in Discord Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Platform 3: Reddit
# Create a script app on https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=test

# Platform 4: GitHub
# Personal Access Token with 'gist' or 'repo' scope
GITHUB_TOKEN=
GITHUB_REPO=

# Platform 5: Mastodon
# Create an access token on any Mastodon instance (Settings -> Development -> New Application)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

